# Public IP or hostname of your VPS (required)
SERVERURL=your.vps.ip.or.domain

# WireGuard listen port (UDP)
SERVERPORT=51820

# Number of client devices (1 = phone, laptop, etc. as separate peers)
PEERS=1

# DNS pushed to clients
PEERDNS=1.1.1.1

# VPN tunnel subnet
INTERNAL_SUBNET=10.13.13.0

# What traffic goes through the VPN (0.0.0.0/0 = full tunnel)
ALLOWEDIPS=0.0.0.0/0

# Keepalive so connections survive NAT (seconds)
PERSISTENTKEEPALIVE_PEERS=25

# Timezone
TZ=UTC
